;; Doom, with its control in Atmos.
;;
;; The engine (engine/, in C) simulates and draws. It starts by itself
;; (D_DoomMain), and where it had its loop of frames, it calls this
;; program (D_DoomFrames), which runs the frames and never returns. The
;; program starts at the first call from the engine, which may come
;; before (see doom_start).
;;
;; The environment below emits:
;;
;;      :frame      once per frame, forever
;;
;; The game ends inside the engine (I_Quit), which exits the process.
;;
;; The parts:
;;
;;      patch.atm   the graphics of the WAD, by name
;;      wipe.atm    the screen wipe
;;      wi.atm      the intermission
;;      fi.atm      the finale
;;      st.atm      the face of the status bar
;;      flow.atm    the flow: the title, the demos, the levels

```:prelude
#include "doomdef.h"
#include "doomstat.h"

#include "d_loop.h"
#include "i_system.h"
#include "i_video.h"
#include "m_argv.h"
#include "s_sound.h"

boolean D_Display (void);

// The program starts at the first call from the engine, which may come
// before D_DoomFrames: D_DoomMain starts the title, and runs a first tic.
static int DOOM_ON = 0;

// An event from the engine to the program, by its tag. The engine calls
// functions of the parts that left it (the intermission, ...), which
// emit. Since the program is inside a call to the engine at that time,
// the status of the emits is kept for the literal that made the call:
//      `TryRunTics(); st = a_chk_aborted(DOOM_ST);`
static AStatus DOOM_ST = A_OK;

static void doom_start (void) {
    if (!DOOM_ON) {
        DOOM_ON = 1;
        atm_init(myargc, myargv);
        DOOM_ST = atm_main();       // the main chunk, up to its first await
    }
}

static void doom_emit (const char* tag) {
    doom_start();
    if (DOOM_ST == A_OK) {
        AVal evt = a_strz(tag);
        DOOM_ST = atm_emit(evt);
        a_dec(evt);
    }
}

// An event from the engine to one task (and what it holds), with no
// traversal of the rest of the program: for an event that only that
// task awaits, and that comes at each tic. A broadcast costs about 180
// instructions for each task that awaits another event.
static void doom_emit_to (AVal to, const char* tag) {
    doom_start();
    if (DOOM_ST == A_OK) {
        AVal evt = a_strz(tag);
        DOOM_ST = atm_emit_to(to, evt);
        a_dec(evt);
    }
}

// Called by the engine, once, in the place of its loop of frames.
void D_DoomFrames (void) {
    doom_start();
    AStatus st = DOOM_ST;

    AVal frame = a_strz("frame");
    while (st==A_OK && atm_alive()) {
        st = atm_emit(frame);
    }
    a_dec(frame);

    if (st == A_OK) {
        st = atm_stop();
    }
    if (st != A_OK) {
        a_error_dump();
    }
    atm_quit();
    I_Error("doom.atm: the program ended");
}
```

include "patch.atm"
include "wipe.atm"
include "wi.atm"
include "fi.atm"
include "st.atm"
include "flow.atm"

;; THE FRAMES
;;
;; A frame reads the input, runs the tics of the game that are due, and
;; draws. When the engine draws a screen that changes the state of the
;; game (a level begins, an intermission, ...), a wipe takes the next
;; frames, and the game waits.

loop on :frame {
    `I_StartFrame();`
    `TryRunTics(); st = a_chk_aborted(DOOM_ST);`
    `S_UpdateSounds(players[consoleplayer].mo);`
    if `:boolean screenvisible && !nodrawers` {
        val wipe = `:boolean D_Display()`
        `st = a_chk_aborted(DOOM_ST);`
        if wipe {
            await Wipe()
        } else {
            `I_FinishUpdate();`
        }
    }
}
