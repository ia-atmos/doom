;; THE MENUS
;;
;; The keys of the menus: the keys that open them and the shortcuts of
;; the function keys, the moves of the skull, the items, the answers to
;; the messages, and the name of a saved game being typed; and the skull
;; that blinks.
;;
;; In the engine, it was M_Responder and M_Ticker, of
;; engine/src/doom/m_menu.c. The rest stays there: the menus as data
;; (each item with a C function to call), those functions, the messages
;; that they start (each with a C function for the answer), and the
;; drawing.
;;
;; The engine emits, each to its task only:
;;
;;      :m.key      an input event became a key (M_Responder): it is in
;;                  `m_key`, `m_ch`, and `m_ev`; the task clears
;;                  `m_eat` for a key that it does not take
;;      :m.tic      once per tic (M_Ticker), to the task Skull

```:prelude
#include <ctype.h>

#include "doomdef.h"
#include "doomkeys.h"
#include "doomstat.h"
#include "dstrings.h"
#include "sounds.h"

#include "deh_main.h"
#include "g_game.h"
#include "hu_stuff.h"
#include "i_input.h"
#include "i_joystick.h"
#include "i_system.h"
#include "i_timer.h"
#include "i_video.h"
#include "m_controls.h"
#include "m_menu.h"
#include "m_misc.h"
#include "p_saveg.h"
#include "s_sound.h"
#include "w_wad.h"
#include "z_zone.h"

// Types of engine/src/doom/m_menu.c.
typedef struct
{
    short	status;         // 0: no cursor, 1: ok, 2: arrows ok, -1: a hole
    char	name[10];
    void	(*routine)(int choice);
    char	alphaKey;
} menuitem_t;

typedef struct menu_s
{
    short		numitems;
    struct menu_s*	prevMenu;
    menuitem_t*		menuitems;
    void		(*routine)();
    short		x;
    short		y;
    short		lastOn;
} menu_t;

#define M_SFX_VOL 0     // the first item of the menu of the sound

// Variables and functions of engine/src/doom/m_menu.c.
extern int		messageToPrint;
extern int		messageLastMenuActive;
extern boolean		messageNeedsInput;
extern void		(*messageRoutine)(int response);
extern char		gammamsg[5][26];
extern int		saveStringEnter;
extern int		saveSlot;
extern int		saveCharIndex;
extern boolean		joypadSave;
extern char		saveOldString[SAVESTRINGSIZE];
extern char		savegamestrings[10][SAVESTRINGSIZE];
extern short		itemOn;
extern short		whichSkull;
extern menu_t*		currentMenu;
extern menu_t		ReadDef1, ReadDef2, SoundDef, SaveDef;
extern boolean		chat_on;

void M_LoadGame(int choice);
void M_SaveGame(int choice);
void M_EndGame(int choice);
void M_QuitDOOM(int choice);
void M_QuitResponse(int key);
void M_ChangeMessages(int choice);
void M_ChangeDetail(int choice);
void M_SizeDisplay(int choice);
void M_QuickSave(void);
void M_QuickLoad(void);
void M_DoSave(int slot);
int  M_StringWidth(const char *string);
void M_ClearMenus (void);

// The tasks Menu and Skull, which alone await :m.key and :m.tic.
static AVal MENU, SKULL;
static int MENU_ON = 0;

static int m_key;           // the key of :m.key
static int m_ch;            // the character typed, or 0
static event_t* m_ev;
static boolean m_eat;       // the key was taken

// Called by the engine with an input event: the test of the controls,
// the close button of the window, and the joystick and the mouse made
// keys, as they were; then the key goes to the task Menu.
boolean M_Responder (event_t* ev)
{
    doom_start();

    int             ch;
    int             key;
    int             i;
    static  int     mousewait = 0;
    static  int     mousey = 0;
    static  int     lasty = 0;
    static  int     mousex = 0;
    static  int     lastx = 0;
    int dir;

    // In testcontrols mode, none of the function keys should do anything
    // - the only key is escape to quit.

    if (testcontrols)
    {
        if (ev->type == ev_quit
         || (ev->type == ev_keydown
          && (ev->data1 == key_menu_activate || ev->data1 == key_menu_quit)))
        {
            I_Quit();
            return true;
        }

        return false;
    }

    // "close" button pressed on window?
    if (ev->type == ev_quit)
    {
        // First click on close button = bring up quit confirm message.
        // Second click on close button = confirm quit

        if (menuactive && messageToPrint && messageRoutine == M_QuitResponse)
        {
            M_QuitResponse(key_menu_confirm);
        }
        else
        {
            S_StartSound(NULL,sfx_swtchn);
            M_QuitDOOM(0);
        }

        return true;
    }

    // key is the key pressed, ch is the actual character typed
  
    ch = 0;
    key = -1;
	
    if (ev->type == ev_joystick)
    {
        // Simulate key presses from joystick events to interact with the menu.

        if (menuactive)
        {
            if (JOY_GET_DPAD(ev->data6) != JOY_DIR_NONE)
            {
                dir = JOY_GET_DPAD(ev->data6);
            }
            else if (JOY_GET_LSTICK(ev->data6) != JOY_DIR_NONE)
            {
                dir = JOY_GET_LSTICK(ev->data6);
            }
            else
            {
                dir = JOY_GET_RSTICK(ev->data6);
            }

            if (dir & JOY_DIR_UP)
            {
                key = key_menu_up;
                joywait = I_GetTime() + 5;
            }
            else if (dir & JOY_DIR_DOWN)
            {
                key = key_menu_down;
                joywait = I_GetTime() + 5;
            }
            if (dir & JOY_DIR_LEFT)
            {
                key = key_menu_left;
                joywait = I_GetTime() + 5;
            }
            else if (dir & JOY_DIR_RIGHT)
            {
                key = key_menu_right;
                joywait = I_GetTime() + 5;
            }

#define JOY_BUTTON_MAPPED(x) ((x) >= 0)
#define JOY_BUTTON_PRESSED(x) (JOY_BUTTON_MAPPED(x) && (ev->data1 & (1 << (x))) != 0)

            if (JOY_BUTTON_PRESSED(joybfire))
            {
                // Simulate a 'Y' keypress when Doom show a Y/N dialog with Fire button.
                if (messageToPrint && messageNeedsInput)
                {
                    key = key_menu_confirm;
                }
                // Simulate pressing "Enter" when we are supplying a save slot name
                else if (saveStringEnter)
                {
                    key = KEY_ENTER;
                }
                else
                {
                    // if selecting a save slot via joypad, set a flag
                    if (currentMenu == &SaveDef)
                    {
                        joypadSave = true;
                    }
                    key = key_menu_forward;
                }
                joywait = I_GetTime() + 5;
            }
            if (JOY_BUTTON_PRESSED(joybuse))
            {
                // Simulate a 'N' keypress when Doom show a Y/N dialog with Use button.
                if (messageToPrint && messageNeedsInput)
                {
                    key = key_menu_abort;
                }
                // If user was entering a save name, back out
                else if (saveStringEnter)
                {
                    key = KEY_ESCAPE;
                }
                else
                {
                    key = key_menu_back;
                }
                joywait = I_GetTime() + 5;
            }
        }
        if (JOY_BUTTON_PRESSED(joybmenu))
        {
            key = key_menu_activate;
            joywait = I_GetTime() + 5;
        }
    }
    else
    {
	if (ev->type == ev_mouse && mousewait < I_GetTime() && menuactive)
	{
	    mousey += ev->data3;
	    if (mousey < lasty-30)
	    {
		key = key_menu_down;
		mousewait = I_GetTime() + 5;
		mousey = lasty -= 30;
	    }
	    else if (mousey > lasty+30)
	    {
		key = key_menu_up;
		mousewait = I_GetTime() + 5;
		mousey = lasty += 30;
	    }
		
	    mousex += ev->data2;
	    if (mousex < lastx-30)
	    {
		key = key_menu_left;
		mousewait = I_GetTime() + 5;
		mousex = lastx -= 30;
	    }
	    else if (mousex > lastx+30)
	    {
		key = key_menu_right;
		mousewait = I_GetTime() + 5;
		mousex = lastx += 30;
	    }
		
	    if (ev->data1&1)
	    {
		key = key_menu_forward;
		mousewait = I_GetTime() + 15;
	    }
			
	    if (ev->data1&2)
	    {
		key = key_menu_back;
		mousewait = I_GetTime() + 15;
	    }
	}
	else
	{
	    if (ev->type == ev_keydown)
	    {
		key = ev->data1;
		ch = ev->data2;
	    }
	}
    }
    
    if (key == -1)
	return false;

    m_key = key;
    m_ch = ch;
    m_ev = ev;
    m_eat = true;
    if (MENU_ON) {
        doom_emit_to(MENU, "m.key");
    }
    return m_eat;
}

// Called by the engine once per tic.
void M_Ticker (void) {
    doom_start();
    if (MENU_ON) {
        doom_emit_to(SKULL, "m.tic");
    }
}

// A character of the name of a saved game, if the font has it and the
// name has room.
static void m_type_char (void) {
    event_t* ev = m_ev;
    int ch;
    // Vanilla has a bug where the shift key is ignored when entering a
    // savegame name: it is emulated with vanilla_keyboard_mapping.
    if (ev->type != ev_keydown) {
        return;
    }
    if (vanilla_keyboard_mapping) {
        ch = ev->data1;
    } else {
        ch = ev->data3;
    }
    ch = toupper(ch);
    if (ch != ' '
     && (ch - HU_FONTSTART < 0 || ch - HU_FONTSTART >= HU_FONTSIZE)) {
        return;
    }
    if (ch >= 32 && ch <= 127 &&
        saveCharIndex < SAVESTRINGSIZE-1 &&
        M_StringWidth(savegamestrings[saveSlot]) < (SAVESTRINGSIZE-2)*8) {
        savegamestrings[saveSlot][saveCharIndex++] = ch;
        savegamestrings[saveSlot][saveCharIndex] = 0;
    }
}

// The next item, after the current one and around, whose shortcut is
// the character: true if found (it becomes the current one).
static boolean m_shortcut (int ch) {
    int i;
    for (i = itemOn+1;i < currentMenu->numitems;i++) {
        if (currentMenu->menuitems[i].alphaKey == ch) {
            itemOn = i;
            S_StartSound(NULL,sfx_pstop);
            return true;
        }
    }
    for (i = 0;i <= itemOn;i++) {
        if (currentMenu->menuitems[i].alphaKey == ch) {
            itemOn = i;
            S_StartSound(NULL,sfx_pstop);
            return true;
        }
    }
    return false;
}

// Keys that Vanilla takes as a shortcut with no character.
static boolean m_nullkey (int key) {
    return key == KEY_PAUSE || key == KEY_CAPSLOCK
        || key == KEY_SCRLCK || key == KEY_NUMLOCK;
}
```

;; THE SKULL: it blinks every 8 tics, the first time after 10.
task Skull () {
    val me = task
    `SKULL = $me;`
    await (10, :m.tic)
    loop {
        `whichSkull ^= 1;`
        await (8, :m.tic)
    }
}

;; A key while the name of a saved game is typed: it ends with enter
;; (the game is saved, if the name is not empty) or escape (the old name
;; is back).
func m_type (key) {
    ifs {
        key == `:number KEY_BACKSPACE` => {
            `if (saveCharIndex > 0) { saveCharIndex--; savegamestrings[saveSlot][saveCharIndex] = 0; }`
        }
        key == `:number KEY_ESCAPE` => {
            `saveStringEnter = 0;`
            `I_StopTextInput();`
            `M_StringCopy(savegamestrings[saveSlot], saveOldString, SAVESTRINGSIZE);`
        }
        key == `:number KEY_ENTER` => {
            `saveStringEnter = 0;`
            `I_StopTextInput();`
            `if (savegamestrings[saveSlot][0]) M_DoSave(saveSlot);`
        }
        else => `m_type_char();`
    }
}

;; A key while a message is on screen: a message that asks takes only
;; an answer (yes, no, space, escape); the function of the message gets
;; it, and the menu closes.
func m_answer (key) {
    val answer = (key == `:number ' '`) || (key == `:number KEY_ESCAPE`) ||
                 (key == `:number key_menu_confirm`) || (key == `:number key_menu_abort`)
    if `:boolean messageNeedsInput` && (!answer) {
        `m_eat = false;`
    } else {
        `menuactive = messageLastMenuActive;`
        `messageToPrint = 0;`
        `if (messageRoutine) messageRoutine((int) a_dbl($key));`
        `menuactive = false;`
        `S_StartSound(NULL,sfx_swtchx);`
    }
}

;; A key with the menus closed: the function keys, and the key that
;; opens the main menu.
func m_closed (key) {
    ifs {
        key == `:number key_menu_decscreen` => {
            if `:boolean automapactive || chat_on` {
                `m_eat = false;`
            } else {
                `M_SizeDisplay(0); S_StartSound(NULL,sfx_stnmov);`
            }
        }
        key == `:number key_menu_incscreen` => {
            if `:boolean automapactive || chat_on` {
                `m_eat = false;`
            } else {
                `M_SizeDisplay(1); S_StartSound(NULL,sfx_stnmov);`
            }
        }
        key == `:number key_menu_help` => {
            `M_StartControlPanel();`
            `currentMenu = (gameversion >= exe_ultimate) ? &ReadDef2 : &ReadDef1;`
            `itemOn = 0;`
            `S_StartSound(NULL,sfx_swtchn);`
        }
        key == `:number key_menu_save` => {
            `M_StartControlPanel(); S_StartSound(NULL,sfx_swtchn); M_SaveGame(0);`
        }
        key == `:number key_menu_load` => {
            `M_StartControlPanel(); S_StartSound(NULL,sfx_swtchn); M_LoadGame(0);`
        }
        key == `:number key_menu_volume` => {
            `M_StartControlPanel(); currentMenu = &SoundDef; itemOn = M_SFX_VOL; S_StartSound(NULL,sfx_swtchn);`
        }
        key == `:number key_menu_detail` => {
            `M_ChangeDetail(0); S_StartSound(NULL,sfx_swtchn);`
        }
        key == `:number key_menu_qsave` => {
            `S_StartSound(NULL,sfx_swtchn); M_QuickSave();`
        }
        key == `:number key_menu_endgame` => {
            `S_StartSound(NULL,sfx_swtchn); M_EndGame(0);`
        }
        key == `:number key_menu_messages` => {
            `M_ChangeMessages(0); S_StartSound(NULL,sfx_swtchn);`
        }
        key == `:number key_menu_qload` => {
            `S_StartSound(NULL,sfx_swtchn); M_QuickLoad();`
        }
        key == `:number key_menu_quit` => {
            `S_StartSound(NULL,sfx_swtchn); M_QuitDOOM(0);`
        }
        key == `:number key_menu_gamma` => {
            `usegamma++; if (usegamma > 4) usegamma = 0;`
            `players[consoleplayer].message = DEH_String(gammamsg[usegamma]);`
            `I_SetPalette (W_CacheLumpName (DEH_String("PLAYPAL"),PU_CACHE));`
        }
        key == `:number key_menu_activate` => {
            `M_StartControlPanel(); S_StartSound(NULL,sfx_swtchn);`
        }
        else => `m_eat = false;`
    }
}

;; A key with a menu open: the skull moves, an item is chosen or slid,
;; the menu goes back or closes, or a shortcut moves the skull.
func m_open (key, ch) {
    ifs {
        key == `:number key_menu_down` => {
            loop {
                `if (itemOn+1 > currentMenu->numitems-1) itemOn = 0; else itemOn++;`
                `S_StartSound(NULL,sfx_pstop);`
                while `:boolean currentMenu->menuitems[itemOn].status == -1`
            }
        }
        key == `:number key_menu_up` => {
            loop {
                `if (!itemOn) itemOn = currentMenu->numitems-1; else itemOn--;`
                `S_StartSound(NULL,sfx_pstop);`
                while `:boolean currentMenu->menuitems[itemOn].status == -1`
            }
        }
        key == `:number key_menu_left` => {
            if `:boolean currentMenu->menuitems[itemOn].routine && currentMenu->menuitems[itemOn].status == 2` {
                `S_StartSound(NULL,sfx_stnmov);`
                `currentMenu->menuitems[itemOn].routine(0);`
            }
        }
        key == `:number key_menu_right` => {
            if `:boolean currentMenu->menuitems[itemOn].routine && currentMenu->menuitems[itemOn].status == 2` {
                `S_StartSound(NULL,sfx_stnmov);`
                `currentMenu->menuitems[itemOn].routine(1);`
            }
        }
        key == `:number key_menu_forward` => {
            if `:boolean currentMenu->menuitems[itemOn].routine && currentMenu->menuitems[itemOn].status` {
                `currentMenu->lastOn = itemOn;`
                if `:boolean currentMenu->menuitems[itemOn].status == 2` {
                    `currentMenu->menuitems[itemOn].routine(1);`      ;; as the right arrow
                    `S_StartSound(NULL,sfx_stnmov);`
                } else {
                    `currentMenu->menuitems[itemOn].routine(itemOn);`
                    `S_StartSound(NULL,sfx_pistol);`
                }
            }
        }
        key == `:number key_menu_activate` => {
            `currentMenu->lastOn = itemOn;`
            `M_ClearMenus();`
            `S_StartSound(NULL,sfx_swtchx);`
        }
        key == `:number key_menu_back` => {
            `currentMenu->lastOn = itemOn;`
            `if (currentMenu->prevMenu) { currentMenu = currentMenu->prevMenu; itemOn = currentMenu->lastOn; S_StartSound(NULL,sfx_swtchn); }`
        }
        (ch != 0) || `:boolean m_nullkey(m_key)` => {
            ;; Vanilla jumps to the sliders with some keys: emulated
            `m_eat = m_shortcut(m_ch);`
        }
        else => `m_eat = false;`
    }
}

;; THE MENU: each key goes, in this order, to the name being typed, to
;; the message on screen, to the screenshot, and then to the closed or
;; to the open menus. The functions of the items and of the messages,
;; in C, are what open and close the menus, start the messages, and
;; start the typing.
task Menu () {
    val me = task
    `MENU = $me; MENU_ON = 1;`
    loop on :m.key {
        val key = `:number m_key`
        val ch  = `:number m_ch`
        ifs {
            `:boolean saveStringEnter` => m_type(key)
            `:boolean messageToPrint`  => m_answer(key)
            `:boolean (devparm && m_key == key_menu_help) || (m_key != 0 && m_key == key_menu_screenshot)` => {
                `G_ScreenShot();`
            }
            !`:boolean menuactive` => m_closed(key)
            else => m_open(key, ch)
        }
    }
}

spawn Skull()
spawn Menu()
